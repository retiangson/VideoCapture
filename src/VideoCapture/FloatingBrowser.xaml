<Window x:Class="VideoCapture.FloatingBrowser"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Floating browser" Icon="Assets/AppIcon.png" Width="850" Height="620" MinWidth="460" MinHeight="400"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
 WindowStartupLocation="CenterOwner" PreviewKeyDown="Browser_KeyDown">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PlayerTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="#18212C" BorderBrush="#65768B" BorderThickness="1" CornerRadius="7" Padding="7">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,7" MouseLeftButtonDown="Drag_MouseDown">
    <Button Content="Hide (Ctrl+Shift+B)" DockPanel.Dock="Right" Click="Hide_Click" Padding="8,4"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0">
     <TextBlock Text="Panel opacity" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <Slider x:Name="Transparency" Width="110" Minimum="0.3" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="Transparency applies to the browser and all controls; everything remains clickable"/>
    </StackPanel>
    <TextBlock Text="⋮⋮  Floating browser" Foreground="White" FontWeight="SemiBold" Padding="6" Cursor="SizeAll" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Border x:Name="VideoTools" Grid.Row="4" Background="#101923" CornerRadius="7" Padding="8" Margin="0,0,0,7"><StackPanel>
    <WrapPanel>
     <Button x:Name="CopyVideoFrameButton" IsEnabled="False" Click="CopyVideoFrame_Click" ToolTip="Copy the video picture to the clipboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="Copy frame"/></StackPanel></Button>
     <Button x:Name="RecordVideoButton" IsEnabled="False" Click="RecordVideo_Click" Background="#9B344E" BorderBrush="#B64662"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#FFCAD6" Margin="0,0,7,0"/><TextBlock x:Name="RecordVideoLabel" Text="Record video"/></StackPanel></Button>
     <Button x:Name="CopyVideoTextButton" IsEnabled="False" Click="CopyVideoText_Click" ToolTip="Recognize text from the video and copy it"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="Copy video text"/></StackPanel></Button>
     <Button x:Name="AudioTextButton" IsEnabled="False" Click="AudioText_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Capture the video's spoken audio, then convert it to editable text"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock x:Name="AudioTextLabel" Text="Audio to text"/></StackPanel></Button>
     <TextBlock x:Name="VideoRecordingTime" Foreground="#FF91AC" VerticalAlignment="Center" Margin="5,0,0,0"/>
    </WrapPanel>
    <TextBlock x:Name="VideoFeedback" Text="Video only · browser and other windows are excluded" Foreground="#91A0B7" FontSize="10" TextWrapping="Wrap" Margin="2,6,2,0"/>
    <Expander x:Name="TranscriptPanel" Header="Audio transcript" Foreground="#C1CEDD" FontSize="11" Margin="2,6,2,0" Expanded="TranscriptPanel_Expanded" Collapsed="TranscriptPanel_Collapsed"><StackPanel Margin="0,6,0,0">
     <WrapPanel><ComboBox x:Name="TranscriptLanguage" Width="190" Height="28" MinHeight="28" Margin="0,0,6,5" SelectionChanged="TranscriptLanguage_Changed" IsEnabled="False" ToolTip="Installed Windows speech-recognition language"/>
      <Button x:Name="CopyTranscriptButton" Content="Copy transcript" IsEnabled="False" Click="CopyTranscript_Click" MinHeight="28" Padding="8,4" Margin="0,0,6,5"/>
      <Button x:Name="CancelAudioButton" Content="Cancel" IsEnabled="False" Click="CancelAudio_Click" MinHeight="28" Padding="8,4" Margin="0,0,0,5"/>
     </WrapPanel>
     <TextBox x:Name="TranscriptText" Height="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#172236" Foreground="#E8EEF7" BorderBrush="#344157" Padding="6" FontSize="12" TextChanged="TranscriptText_Changed" ToolTip="Review and correct the transcript, then copy it"/>
     <TextBlock x:Name="TranscriptStatus" Text="Offline Windows dictation · video audio only · up to 2 minutes" Foreground="#91A0B7" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel></Expander>
   </StackPanel></Border>
   <Expander x:Name="NavigationPanel" Grid.Row="3" Header="Navigation · address and history" Foreground="#C1CEDD" FontSize="11" Margin="2,6,2,6">
   <DockPanel Margin="0,6,0,4">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="BackButton" Content="←" Click="Back_Click" Padding="10,5" IsEnabled="False"/><Button x:Name="ForwardButton" Content="→" Click="Forward_Click" Padding="10,5" IsEnabled="False"/><Button Content="↻" Click="Reload_Click" Padding="10,5"/></StackPanel>
    <Button Content="Go" DockPanel.Dock="Right" Click="Go_Click" Padding="12,5"/>
    <TextBox x:Name="Address" Padding="8,5" KeyDown="Address_KeyDown" ToolTip="Enter an https:// or http:// address"/>
   </DockPanel>
   </Expander>
   <DockPanel Grid.Row="1" Margin="0,0,0,6">
    <Button x:Name="NewTabButton" Content="+" DockPanel.Dock="Right" Click="NewTab_Click" Padding="0" Width="26" Height="24" MinHeight="24" FontSize="14" VerticalAlignment="Top" ToolTip="New tab (Ctrl+T)" IsEnabled="False"/>
    <TabControl x:Name="Tabs" SelectionChanged="Tab_Changed" Background="#283342" BorderThickness="0" MinHeight="24">
     <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="11"/><Setter Property="MaxWidth" Value="164"/></Style></TabControl.Resources>
    </TabControl>
   </DockPanel>
   <Grid x:Name="BrowserHost" Grid.Row="2" MinHeight="100" ClipToBounds="True"/>
   <TextBlock x:Name="Feedback" Grid.Row="5" Text="Starting browser…" Foreground="#C1CEDD" TextWrapping="Wrap" Margin="4,6"/>
  </Grid>
 </Border>
</Window>
