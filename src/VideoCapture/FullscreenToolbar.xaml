<Window x:Class="VideoCapture.FullscreenToolbar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ShowActivated="False" PreviewMouseWheel="Menu_MouseWheel" PreviewKeyDown="Toolbar_KeyDown">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PlayerTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="{StaticResource PlayerPanel}" CornerRadius="14" BorderBrush="#525D56" BorderThickness="1" Padding="15,12">
  <StackPanel MaxWidth="920">
   <DockPanel Margin="0,0,0,10">
    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="#A1ABA6" FontSize="15" Padding="0,4,12,4" Cursor="SizeAll" MouseLeftButtonDown="Grip_MouseDown" ToolTip="Drag menu"/>
    <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Click="Hide_Click" DockPanel.Dock="Right" ToolTip="Hide controls · hold left-click on video to show" AutomationProperties.Name="Hide menu" Margin="0" Width="28" Height="28" MinHeight="28" Padding="4"/>
    <TextBlock x:Name="Elapsed" Text="00:00:00" Foreground="#FF91AC" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"/>
    <TextBlock Text="VideoCapture" Foreground="#EEF3EF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <DockPanel x:Name="ProgressPanel" Margin="0,0,0,9">
    <TextBlock x:Name="MenuPositionText" Text="00:00:00 / 00:00:00" DockPanel.Dock="Right" Foreground="#A1ABA6" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
    <Slider x:Name="MenuSeek" Minimum="0" Maximum="1000" IsEnabled="False" ValueChanged="MenuSeek_Changed" ToolTip="Seek video" AutomationProperties.Name="Video progress"/>
   </DockPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
    <Button x:Name="PreviousButton" Content="&#xE892;" Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="Previous video" AutomationProperties.Name="Previous video"/>
    <Button x:Name="PlayButton" Content="&#xE768;" Style="{StaticResource PlayHeroButton}" Click="Play_Click" ToolTip="Play / Pause" AutomationProperties.Name="Play or pause"/>
    <Button x:Name="StopButton" Content="&#xE71A;" Style="{StaticResource IconButton}" Click="Stop_Click" ToolTip="Stop" AutomationProperties.Name="Stop"/>
    <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource IconButton}" Click="Next_Click" ToolTip="Next video" AutomationProperties.Name="Next video"/>
    <Button x:Name="RecordButton" Click="Record_Click" Background="#9B344E" BorderBrush="#B64662" Margin="3,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#FFCAD6" Margin="0,0,7,0"/><TextBlock x:Name="RecordLabel" Text="Record"/></StackPanel></Button>
   </StackPanel>
   <WrapPanel Margin="0,0,0,12">
    <Button Content="&#xE8B7;" Style="{StaticResource IconButton}" Click="Open_Click" ToolTip="Open videos" AutomationProperties.Name="Open videos"/>
    <Button Content="&#xE8F1;" Style="{StaticResource IconButton}" Click="Playlist_Click" ToolTip="Manage playlist" AutomationProperties.Name="Playlist"/>
    <Button x:Name="CopyFrameButton" Content="&#xE722;" Style="{StaticResource IconButton}" Click="CopyFrame_Click" ToolTip="Copy frame (Ctrl+Shift+C)" AutomationProperties.Name="Copy frame"/>
    <Button x:Name="CopyTextButton" Content="&#xE8A5;" Style="{StaticResource IconButton}" Click="CopyText_Click" ToolTip="Copy video text (Ctrl+Shift+T)" AutomationProperties.Name="Copy video text"/>
    <Button x:Name="ScreenTextButton" Content="&#xE7C4;" Style="{StaticResource IconButton}" Click="ScreenText_Click" ToolTip="Select screen text (Ctrl+Shift+X)" AutomationProperties.Name="Screen text"/>
    <Button x:Name="SaveFrameButton" Content="&#xE74E;" Style="{StaticResource IconButton}" Click="SaveFrame_Click" ToolTip="Save frame" AutomationProperties.Name="Save frame"/>
    <Button x:Name="CopyRecordingButton" Content="&#xE8C8;" Style="{StaticResource IconButton}" Click="CopyRecording_Click" ToolTip="Copy last recording file" AutomationProperties.Name="Copy recording"/>
    <Button x:Name="FitButton" Content="Regular" Click="Fit_Click" ToolTip="Show whole frame" AutomationProperties.Name="Picture fit"/>
    <Button x:Name="SpeechButton" Content="Read aloud" Click="Speech_Click" ToolTip="Toggle subtitle speech"/>
    <Button x:Name="ProgressButton" Content="Timeline" Click="Progress_Click" ToolTip="Hide video progress"/>
    <Button x:Name="BrowserButton" Content="&#xE774;" Style="{StaticResource IconButton}" Click="Browser_Click" ToolTip="Floating browser" AutomationProperties.Name="Browser"/>
    <Button Content="&#xE8AE;" Style="{StaticResource IconButton}" Click="Cec_Click" ToolTip="CEC remote" AutomationProperties.Name="CEC remote"/>
    <Button x:Name="ExitButton" Content="&#xE73F;" Style="{StaticResource IconButton}" Click="Exit_Click" ToolTip="Exit fullscreen (Esc)" AutomationProperties.Name="Exit fullscreen" Margin="0"/>
   </WrapPanel>
   <Grid MinWidth="700"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=MenuVolume, StringFormat={}{0:0}%}" Foreground="#A1ABA6" FontSize="11"/><TextBlock Text="Video volume" Foreground="#A1ABA6" FontSize="11"/></DockPanel>
     <Slider x:Name="MenuVolume" Minimum="0" Maximum="100" Value="75" ValueChanged="MenuVolume_Changed" ToolTip="Video sound volume" AutomationProperties.Name="Video volume"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,20,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=MenuSpeechVolume, StringFormat={}{0:0}%}" Foreground="#A1ABA6" FontSize="11"/><TextBlock Text="Reading volume" Foreground="#A1ABA6" FontSize="11"/></DockPanel>
     <Slider x:Name="MenuSpeechVolume" Minimum="0" Maximum="100" Value="85" ValueChanged="MenuSpeechVolume_Changed" ToolTip="Subtitle reading volume" AutomationProperties.Name="Reading volume"/>
    </StackPanel>
    <StackPanel Grid.Column="2"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Foreground="#A1ABA6" FontSize="11"/><TextBlock Text="Menu opacity" Foreground="#A1ABA6" FontSize="11"/></DockPanel>
     <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Value="0.96" SmallChange="0.01" LargeChange="0.1" ValueChanged="MenuOpacity_Changed" ToolTip="Transparency applies to this entire menu"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="Feedback" Text="Hold left-click to show controls · Tap to hide · Right-click for browser · Esc exits fullscreen" Foreground="#87958D" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="880"/>
  </StackPanel>
 </Border>
</Window>
