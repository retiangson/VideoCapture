<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <Resource Include="Assets\AppIcon.png" />
    <Content Include="tessdata\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-OCR.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Models\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\Media\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="VideoCapture.Smoke" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows.GPL" Version="3.0.24" />
  </ItemGroup>

  <Target Name="VerifyCaptureRuntimeBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)libvlc\win-x64\plugins\access\libdshow_plugin.dll')" Text="The DirectShow capture plugin is missing. Use the complete VideoLAN.LibVLC.Windows.GPL runtime." />
  </Target>
  <Target Name="VerifyCaptureRuntimePublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)Models\ggml-small-q5_1.bin')" Text="Offline speech model is missing. Run tools/Setup-SpeechModel.ps1 before publishing." />
    <Error Condition="!Exists('$(PublishDir)libvlc\win-x64\plugins\access\libdshow_plugin.dll')" Text="Published application is missing its DirectShow capture plugin." />
    <Error Condition="!Exists('$(PublishDir)tessdata\eng.traineddata') Or !Exists('$(PublishDir)x64\tesseract55.dll')" Text="Published application is missing its offline OCR model or native runtime." />
    <Error Condition="!Exists('$(PublishDir)Tools\Media\ffmpeg.exe') Or !Exists('$(PublishDir)Tools\Media\ffprobe.exe')" Text="Published application is missing the offline embedded-subtitle reader." />
    <Exec Command="&quot;$(PublishDir)$(AssemblyName).exe&quot; --prepare-runtime" Timeout="120000" />
    <Error Condition="!Exists('$(PublishDir)libvlc\win-x64\plugins\plugins.dat')" Text="Published playback runtime plugin cache was not generated." />
  </Target>
</Project>
