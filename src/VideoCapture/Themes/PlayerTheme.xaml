<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VideoCapture.Controls">
 <SolidColorBrush x:Key="Accent" Color="#25E685"/><SolidColorBrush x:Key="Muted" Color="#A1ABA6"/>
 <LinearGradientBrush x:Key="PlayerPanel" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#333A35" Offset="0"/><GradientStop Color="#1B211D" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="ButtonMetal" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3C4540" Offset="0"/><GradientStop Color="#252C28" Offset="1"/></LinearGradientBrush>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="#EEF3EF"/><Setter Property="Background" Value="{StaticResource ButtonMetal}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#525D56"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
   <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="8"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Ellipse x:Name="ActiveMark" Width="5" Height="5" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid><ControlTemplate.Triggers>
   <Trigger Property="ui:ButtonState.IsActive" Value="True"><Setter TargetName="Surface" Property="Background" Value="#17412D"/><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#E5FFF8"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="8"/></Style>
 <Style x:Key="PlayHeroButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
  <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/><Setter Property="FontSize" Value="27"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
   <Border x:Name="Surface" CornerRadius="50" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"><Border.Effect><DropShadowEffect Color="#25E685" BlurRadius="12" ShadowDepth="0" Opacity="0.18"/></Border.Effect></Border>
   <Border x:Name="Hover" CornerRadius="50" Background="White" Opacity="0"/>
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
   <Ellipse x:Name="ActiveMark" Width="5" Height="5" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Visibility="Collapsed"/>
  </Grid><ControlTemplate.Triggers>
   <Trigger Property="ui:ButtonState.IsActive" Value="True"><Setter TargetName="Surface" Property="Background" Value="#17412D"/><Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.09"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.18"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#25E685"/><Setter Property="Foreground" Value="#09251F"/><Setter Property="BorderBrush" Value="#25E685"/></Style>
 <Style TargetType="Slider">
  <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="ui:SliderInteraction.DirectManipulation" Value="True"/><Setter Property="MinHeight" Value="26"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" MinHeight="26" Margin="2,0">
   <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
    <Track.DecreaseRepeatButton><RepeatButton Focusable="False" Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate><Border Background="#25E685" Height="5" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="18" Height="15"><Thumb.Template><ControlTemplate><Border Background="{StaticResource ButtonMetal}" BorderBrush="#7C8A80" BorderThickness="1" CornerRadius="4"><Border Background="{StaticResource Accent}" Height="2" Margin="4,0" VerticalAlignment="Center" CornerRadius="1"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Focusable="False" Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate><Border Background="#111A14" Height="5" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EEF3EF"/><Setter Property="Background" Value="#202622"/><Setter Property="Padding" Value="10,7"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#314C3C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EEF3EF"/><Setter Property="Background" Value="#282F2B"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="MinHeight" Value="36"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate><Border Background="#282F2B" BorderBrush="#3E4842" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,28,6" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"/>
   <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="10" Foreground="#A1ABA6" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#202622" BorderBrush="#3E4842" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A1ABA6"/><Setter Property="Padding" Value="15,10"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7,7,0,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#273B30"/><Setter Property="Foreground" Value="#25E685"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEF3EF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF3EF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,10"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#263D30"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#597563"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#ABB8AF"/><Setter Property="FontSize" Value="11"/></Style>
</ResourceDictionary>
